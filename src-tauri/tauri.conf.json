{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reality Client",
  "version": "0.1.2",
  "identifier": "com.reality.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reality Client",
        "width": 1280,
        "height": 800,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": true,
        "minimizable": true,
        "shadow": false,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Reality Client",
    "shortDescription": "Minecraft launcher with Fabric",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1MDNCRkExMDI2NDE4RjMKUldUekdHUUNvYjhEWlZlN0cyZUZsaWN1bVE1OHJNdXNoRk02N2ZYZFdFaG9CbkxvbjhuSW10VGMK",
      "endpoints": [
        "https://github.com/offup/reality-client-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
